generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum ParseStatus {
  PENDING
  PARSED
  FAILED
}

enum NotificationType {
  SYSTEM
  APPLICATION
  INTERVIEW
}

// ------------------- USER -------------------
// ------------------- USER -------------------
model User {
  id           Int       @id @default(autoincrement())
  firstName    String?
  lastName     String?
  email        String    @unique
  passwordHash String
  profile      Profile?
  resumes      Resume[]
  apps         Application[]
  notes        Notification[]
  alerts       AlertRule[]
  skills       UserSkill[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


// ------------------- PROFILE -------------------
model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])

  firstName String?
  lastName  String?
  title     String?
  location  String?
  bio       String?
  resume    String?

  skills        String[]
  aiCourses     Json?   // <-- stores recommended courses from milestone
  aiArticles    Json?   // <-- stores recommended articles
  aiAdvice      String[] // <-- stores textual career advice
  updatedAt     DateTime @updatedAt
}


// ------------------- RESUME -------------------
model Resume {
  id          Int         @id @default(autoincrement())
  userId      Int
  fileUrl     String
  parseStatus ParseStatus @default(PENDING)
  uploadedAt  DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------- JOB -------------------
model Job {
  id          Int       @id @default(autoincrement())
  title       String
  company     String
  location    String?
  industry    String?
  url         String?   @unique
  jobType     String?
  description String?
  datePosted  DateTime?
  apps        Application[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ------------------- APPLICATION -------------------
model Application {
  id         Int               @id @default(autoincrement())
  userId     Int
  jobId      Int
  status     ApplicationStatus @default(SAVED)
  appliedAt  DateTime          @default(now())
  isFavorite Boolean           @default(false)
  isArchived Boolean           @default(false)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@index([isFavorite])
  @@index([isArchived])
}


// ------------------- INTERVIEW -------------------
model Interview {
  id             Int         @id @default(autoincrement())
  applicationId  Int
  start          DateTime
  end            DateTime
  mode           String?     // ONLINE | ONSITE | REMOTE
  meetingLink    String?
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([applicationId, start, end]) // for overlap checks
}

// ------------------- NOTIFICATION -------------------
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(SYSTEM)
  message   String
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------- SKILL -------------------
model Skill {
  id       Int         @id @default(autoincrement())
  name     String       @unique   // make single-field unique
  category String?
  users    UserSkill[]
}


// ------------------- USER SKILL -------------------
model UserSkill {
  id          Int    @id @default(autoincrement())
  userId      Int
  skillId     Int
  proficiency Int     @default(1) // 1..5
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// ------------------- ALERT RULE -------------------
model AlertRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  query     String
  frequency String   @default("DAILY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
