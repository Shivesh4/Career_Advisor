{
  "name": "careerhub-selenium-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('artifacts',{recursive:true,force:true});require('fs').mkdirSync('artifacts',{recursive:true});\"",
    "test": "mocha --timeout 60000 \"tests/**/*.spec.js\" --reporter mochawesome --reporter-options reportDir=artifacts,reportFilename=selenium-report,quiet=true",
    "test:open": "npx open-cli artifacts/selenium-report.html"
  },
  "dependencies": {
    "chai": "^4.3.7"
  },
  "devDependencies": {
    "chromedriver": "^142.0.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "exceljs": "^4.4.0",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2",
    "open-cli": "^8.0.0",
    "rimraf": "^6.1.0",
    "selenium-webdriver": "^4.38.0",
    "shx": "^0.4.0",
    "wait-on": "^9.0.3"
  }
}
